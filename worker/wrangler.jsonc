{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "otopon-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://sometimes305.github.io,http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:5173,http://localhost:4173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "otopon-db",
      "database_id": "e4d67e0d-5231-4cf1-8218-70f143fcf3a1",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUDIO",
      "id": "680a6140605a43d388aa2c2ab7cfe05c"
    }
  ]
}
