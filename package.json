{
  "name": "otopon-gravity-soundboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "check": "npm run lint && npm run build && npm run worker:typecheck",
    "preview": "vite preview",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "worker:migrate:local": "wrangler d1 migrations apply otopon-db --local --config worker/wrangler.jsonc",
    "worker:migrate:remote": "wrangler d1 migrations apply otopon-db --remote --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  }
}
